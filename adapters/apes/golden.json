      "own/agent-email",
      "--agent-name",
      "own/agent-name",
      "--key",
      "own/key"
    ],
    "expected": {
      "operation_id": "agent.enroll",
      "permission": "apes.idp[url=own/server].agent[email=own/agent-email]#create",
      "display": "Enroll agent own/agent-name (own/agent-email) at own/server",
      "exact_command": true
    }
  },
  {
    "argv": [
      "update",
      "--email",
      "own/email"
    ],
    "expected": {
      "operation_id": "agent.update",
      "permission": "apes.agent[email=own/email]#edit",
      "display": "Update agent own/email",
