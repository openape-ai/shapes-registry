    }
  },
  {
    "argv": [
      "remove",
      "--email",
      "own/email"
    ],
    "expected": {
      "operation_id": "agent.remove",
      "permission": "apes.agent[email=own/email]#delete",
      "display": "Remove agent own/email",
      "exact_command": true
    }
  },
  {
    "argv": [
      "__no_such_command__"
    ],
    "expected": {
      "operation_id": "exec.run",
      "permission": "apes.host[*].process[command=__no_such_command__]#execute",
      "display": "Execute with elevated privileges: __no_such_command__",
