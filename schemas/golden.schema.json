{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openape-ai/shapes-registry/schemas/golden.schema.json",
  "title": "Shapes Adapter Golden Fixtures",
  "description": "argv (without the executable) and the exact grant detail it must derive; null means no operation may match. Every operation needs at least one matching case. Stored grants carry these permissions, so a change is a decision, not a refresh.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["argv", "expected"],
    "additionalProperties": false,
    "properties": {
      "argv": { "type": "array", "items": { "type": "string" } },
      "expected": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["error"],
            "additionalProperties": false,
            "properties": { "error": { "type": "string" } }
          },
          {
            "type": "object",
            "required": ["operation_id", "permission", "display", "exact_command"],
            "additionalProperties": false,
            "properties": {
              "operation_id": { "type": "string" },
              "permission": { "type": "string" },
              "display": { "type": "string" },
              "exact_command": { "type": "boolean" }
            }
          }
        ]
      },
      "note": { "type": "string" }
    }
  }
}
